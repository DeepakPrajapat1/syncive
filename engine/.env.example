# ---- our own metadata database (Supabase connection string) ----
META_DATABASE_URL=postgres://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# ---- HubSpot app (developers.hubspot.com -> your app -> Auth) ----
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=https://api.synciveapps.com/oauth/callback

# ---- encryption for stored credentials (32-byte hex, generate once) ----
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ---- server ----
PORT=8080
PUBLIC_URL=https://api.synciveapps.com
